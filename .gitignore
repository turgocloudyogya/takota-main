# =========================================================
# Takota - Combined .gitignore (Frontend + Backend)
# =========================================================

# ---------- Dependencies ----------
node_modules/
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
backend/vendor/

# ---------- Frontend build ----------
frontend/dist/
frontend/build/
frontend/coverage/

# ---------- Go / Backend ----------
backend/bin/
backend/main
backend/takota-api
backend/takota-backend
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib
backend/*.test
backend/*.out
backend/go.work
backend/go.sum.bak

# ---------- Environment (NEVER COMMIT SECRETS) ----------
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example
!backend/.env.backup-env

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/*.log

# ---------- Editor & IDE ----------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
*.code-workspace

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Misc / Temp ----------
tmp/
temp/
*.tmp
*.bak
*.cache
.cache/
coverage/
uploads/
storage/
*.pid
*.sql.backup
*.dump
dump.rdb
.minio/
