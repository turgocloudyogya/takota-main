# Takota Project - Combined .gitignore

# ==========================
# Backend (Go)
# ==========================

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
build/
takota-backend
takota-api

# Test binary
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Dependency directories
vendor/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.idea/
*.swp
*.swo
*~
.vscode/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# ==========================
# Frontend (React/Vite)
# ==========================

# Dependencies
web/node_modules/
web/.pnp
web/.pnp.js

# Testing
web/coverage/

# Production
web/dist/
web/build/

# Misc
web/.DS_Store
web/.env.local
web/.env.development.local
web/.env.test.local
web/.env.production.local

# Logs
web/npm-debug.log*
web/yarn-debug.log*
web/yarn-error.log*
web/pnpm-debug.log*
web/lerna-debug.log*

# Editor
web/.vscode/*
!web/.vscode/extensions.json
web/.idea
web/*.suo
web/*.ntvs*
web/*.njsproj
web/*.sln
web/*.sw?

# ==========================
# Database & Services
# ==========================

# PostgreSQL
*.sql.backup
*.dump

# Redis
dump.rdb

# MinIO/S3
.minio/

# Docker
*.pid
docker-compose.override.yml

# ==========================
# Generated Files
# ==========================

# PDF outputs (untuk testing)
*.pdf

# Uploaded files (jika disimpan lokal)
uploads/
storage/

# Cache
.cache/
*.cache

# ==========================
# Documentation
# ==========================

# Generated docs
docs/build/
site/
