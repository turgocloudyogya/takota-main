# =============================================================================
# DOCKER IMAGE CONFIGURATION (Production)
# =============================================================================
# Format: username/repo-name (tanpa ghcr.io/ prefix)
# Contoh: johndoe/takota-app
# Cek di GitHub repo URL: https://github.com/USERNAME/REPO_NAME
GITHUB_REPOSITORY=username/takota-app
IMAGE_TAG=latest

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server Configuration
PORT=8080
APP_ENV=development
GIN_MODE=debug

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY_HOURS=24

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=takota
DB_PASSWORD=takota_password
DB_NAME=takota_db
DB_SSL_MODE=disable
DB_SSL_ENABLE=false
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=10

# Redis Configuration (Optional - leave empty to disable)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== S3 STORAGE CONFIGURATION (REQUIRED) =====
# 
# AWS S3: Leave S3_ENDPOINT empty or comment out
#   - System auto-detects AWS and uses: https://bucket.s3.region.amazonaws.com
#   - Only requires: S3_ACCESS_KEY, S3_SECRET_KEY, S3_BUCKET_NAME, S3_REGION
#   - S3_PUBLIC_HOST optional: for custom domain (e.g., CDN URL)
#
# Cloudflare R2: Must set S3_ENDPOINT
#   - S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
#   - S3_PUBLIC_HOST optional: for custom domain instead of r2.cloudflarestorage.com
#
# MinIO: Must set S3_ENDPOINT
#   - S3_ENDPOINT=http://minio-host:9000
#   - S3_PUBLIC_HOST optional: for preview URLs (e.g., http://localhost:9001)
#

# ===== LOCAL MINIO (Development) =====
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=takota-bucket
S3_USE_SSL=false
S3_USE_PATH_STYLE_ENDPOINT=true
S3_REGION=us-east-1
S3_PUBLIC_HOST=http://localhost:9000

# CloudFront Configuration (Optional)
S3_USE_CLOUDFRONT=false
CLOUDFRONT_DOMAIN=
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_PUBLIC_KEY_ID=

# Application Settings
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=5

# File Upload Limits
MAX_ATTENDANCE_FILE_SIZE_MB=10
MAX_ABSENCE_FILE_SIZE_MB=50
