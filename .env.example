# Server Configuration
PORT=8080
APP_ENV=development
GIN_MODE=debug

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY_HOURS=24

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=takota
DB_PASSWORD=takota_password
DB_NAME=takota_db
DB_SSL_MODE=disable
DB_SSL_ENABLE=false
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=10

# Redis Configuration (Optional - leave empty to disable)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# S3 Storage Configuration
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=takota-bucket
S3_USE_SSL=false
S3_USE_PATH_STYLE_ENDPOINT=true
S3_REGION=us-east-1

# CloudFront Configuration (Optional)
S3_USE_CLOUDFRONT=false
CLOUDFRONT_DOMAIN=
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_PUBLIC_KEY_ID=

# Application Settings
ATTENDANCE_RADIUS_METERS=100
OFFICE_LATITUDE=-7.7546612
OFFICE_LONGITUDE=110.3658561
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=5

# File Upload Limits
MAX_ATTENDANCE_FILE_SIZE_MB=10
MAX_ABSENCE_FILE_SIZE_MB=50
